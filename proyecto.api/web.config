<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Allow MlController's upload limit, including multipart overhead, through
       IIS. ASP.NET Core still enforces its request limits per endpoint. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2010000000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
